generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Counter {
  name    String
  value   Int    @default(0)
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, name])
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  password     String
  name         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  address      String?
  phone        String
  storeMembers StoreMember[]
}

model TempUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String
  password     String
  otp          String
  otpExpiresAt DateTime
}

model TempForgotPassData {
  id           String   @id @default(cuid())
  email        String   @unique
  otp          String
  otpExpiresAt DateTime
  isVerified   Boolean  @default(false)
}

model Store {
  id                String            @id @default(cuid())
  name              String
  email             String            @unique
  phone             String
  logo              Json?
  tagline           String?
  address           String
  invoiceFooterNote String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  brands            Brand[]
  categories        Category[]
  counters          Counter[]
  customers         Customer[]
  products          Product[]
  productSuppliers  ProductSupplier[]
  purchases         Purchase[]
  purchaseItems     PurchaseItem[]
  purchasePayments  PurchasePayment[]
  returns           Return[]
  returnItems       ReturnItem[]
  sales             Sale[]
  saleItems         SaleItem[]
  salePayments      SalePayment[]
  stockMovements    StockMovement[]
  members           StoreMember[]
  suppliers         Supplier[]
}

model StoreMember {
  id        String
  storeId   String
  userId    String
  role      StoreMemberRole @default(SALESMAN)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  store     Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([storeId, id])
  @@unique([id, storeId])
  @@unique([storeId, userId])
  @@index([storeId])
  @@index([userId])
}

model Category {
  id        String
  storeId   String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  slug      String
  deletedAt DateTime?
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products  Product[]

  @@id([storeId, id])
  @@unique([id, storeId])
  @@unique([storeId, name])
  @@unique([storeId, slug])
  @@index([storeId])
}

model Brand {
  id        String
  storeId   String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  slug      String
  deletedAt DateTime?
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products  Product[]

  @@id([storeId, id])
  @@unique([id, storeId])
  @@unique([storeId, name])
  @@unique([storeId, slug])
  @@index([storeId])
}

model Product {
  id                String
  storeId           String
  name              String
  image             Json?
  sku               String
  barcode           String?
  categoryId        String
  brandId           String
  description       String?
  price             Decimal           @db.Decimal(12, 2)
  sellingPrice      Decimal           @db.Decimal(12, 2)
  stock             Int               @default(0)
  minimumStockLevel Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  slug              String
  deletedAt         DateTime?
  isLowStock        Boolean           @default(false)
  brand             Brand             @relation(fields: [brandId, storeId], references: [id, storeId])
  category          Category          @relation(fields: [categoryId, storeId], references: [id, storeId])
  store             Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  suppliers         ProductSupplier[]
  purchaseItems     PurchaseItem[]
  returnItems       ReturnItem[]
  saleItems         SaleItem[]
  stockMovements    StockMovement[]

  @@id([storeId, id])
  @@unique([id, storeId])
  @@unique([storeId, sku])
  @@unique([storeId, barcode])
  @@unique([storeId, slug])
  @@index([storeId, categoryId])
  @@index([storeId, brandId])
  @@index([storeId, deletedAt])
  @@index([storeId, isLowStock])
  @@index([brandId, storeId], map: "Product_brandId_storeId_fkey")
  @@index([categoryId, storeId], map: "Product_categoryId_storeId_fkey")
  @@index([storeId])
}

model Supplier {
  id        String
  storeId   String
  name      String
  shopName  String?
  phone     String
  email     String?
  address   String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  deletedAt DateTime?
  products  ProductSupplier[]
  purchases Purchase[]
  payments  PurchasePayment[]
  returns   Return[]
  store     Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, id])
  @@unique([id, storeId])
  @@unique([storeId, phone])
  @@index([storeId, name])
  @@index([storeId])
}

model ProductSupplier {
  storeId    String
  productId  String
  supplierId String
  product    Product  @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Cascade)
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier   Supplier @relation(fields: [supplierId, storeId], references: [id, storeId], onDelete: Cascade)

  @@id([storeId, productId, supplierId])
  @@index([productId, storeId], map: "ProductSupplier_productId_storeId_fkey")
  @@index([storeId])
  @@index([supplierId, storeId], map: "ProductSupplier_supplierId_storeId_fkey")
}

model Customer {
  id        String
  storeId   String
  name      String
  email     String?
  phone     String
  address   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?
  store     Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  returns   Return[]
  sales     Sale[]
  payments  SalePayment[]

  @@id([storeId, id])
  @@unique([id, storeId])
  @@unique([storeId, phone])
  @@index([storeId, name])
  @@index([storeId])
}

model Purchase {
  id             String
  storeId        String
  supplierId     String?
  dueDate        DateTime?
  paymentMethod  PaymentMethod
  subtotal       Decimal           @db.Decimal(12, 2)
  discount       Decimal           @default(0.00) @db.Decimal(12, 2)
  paid           Decimal           @default(0.00) @db.Decimal(12, 2)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  total          Decimal           @db.Decimal(12, 2)
  store          Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier       Supplier?         @relation(fields: [supplierId, storeId], references: [id, storeId])
  items          PurchaseItem[]
  payments       PurchasePayment[]
  stockMovements StockMovement[]

  @@id([storeId, id])
  @@unique([id, storeId])
  @@index([storeId, supplierId])
  @@index([storeId])
  @@index([supplierId, storeId], map: "Purchase_supplierId_storeId_fkey")
}

model PurchaseItem {
  id          String   @id @default(cuid())
  storeId     String
  purchaseId  String
  productId   String
  productName String
  quantity    Int
  price       Decimal  @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId, storeId], references: [id, storeId])
  purchase    Purchase @relation(fields: [purchaseId, storeId], references: [id, storeId], onDelete: Cascade)
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, purchaseId])
  @@index([storeId, productId])
  @@index([productId, storeId], map: "PurchaseItem_productId_storeId_fkey")
  @@index([purchaseId, storeId], map: "PurchaseItem_purchaseId_storeId_fkey")
  @@index([storeId])
}

model PurchasePayment {
  id            String        @id @default(cuid())
  storeId       String
  supplierId    String?
  purchaseId    String
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  createdAt     DateTime      @default(now())
  purchase      Purchase      @relation(fields: [purchaseId, storeId], references: [id, storeId], onDelete: Cascade)
  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier      Supplier?     @relation(fields: [supplierId, storeId], references: [id, storeId])

  @@index([storeId, supplierId])
  @@index([storeId, purchaseId])
  @@index([purchaseId, storeId], map: "PurchasePayment_purchaseId_storeId_fkey")
  @@index([storeId])
  @@index([supplierId, storeId], map: "PurchasePayment_supplierId_storeId_fkey")
}

model Sale {
  id             String
  storeId        String
  customerId     String?
  subtotal       Decimal         @db.Decimal(12, 2)
  discount       Decimal         @default(0.00) @db.Decimal(12, 2)
  paid           Decimal         @default(0.00) @db.Decimal(12, 2)
  paymentMethod  PaymentMethod
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  total          Decimal         @db.Decimal(12, 2)
  customer       Customer?       @relation(fields: [customerId, storeId], references: [id, storeId])
  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items          SaleItem[]
  payments       SalePayment[]
  stockMovements StockMovement[]

  @@id([storeId, id])
  @@unique([id, storeId])
  @@index([storeId, customerId])
  @@index([customerId, storeId], map: "Sale_customerId_storeId_fkey")
  @@index([storeId])
}

model SaleItem {
  id          String   @id @default(cuid())
  storeId     String
  saleId      String
  productId   String
  productName String
  quantity    Int
  price       Decimal  @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId, storeId], references: [id, storeId])
  sale        Sale     @relation(fields: [saleId, storeId], references: [id, storeId], onDelete: Cascade)
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, saleId])
  @@index([storeId, productId])
  @@index([productId, storeId], map: "SaleItem_productId_storeId_fkey")
  @@index([saleId, storeId], map: "SaleItem_saleId_storeId_fkey")
  @@index([storeId])
}

model SalePayment {
  id            String        @id @default(cuid())
  storeId       String
  customerId    String?
  saleId        String
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  createdAt     DateTime      @default(now())
  customer      Customer?     @relation(fields: [customerId, storeId], references: [id, storeId])
  sale          Sale          @relation(fields: [saleId, storeId], references: [id, storeId], onDelete: Cascade)
  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, customerId])
  @@index([storeId, saleId])
  @@index([customerId, storeId], map: "SalePayment_customerId_storeId_fkey")
  @@index([saleId, storeId], map: "SalePayment_saleId_storeId_fkey")
  @@index([storeId])
}

model StockMovement {
  id          String            @id @default(cuid())
  storeId     String
  productId   String
  type        StockMovementType
  reason      String?
  beforeStock Int
  afterStock  Int
  purchaseId  String?
  saleId      String?
  createdAt   DateTime          @default(now())
  returnId    String?
  product     Product           @relation(fields: [productId, storeId], references: [id, storeId])
  purchase    Purchase?         @relation(fields: [purchaseId, storeId], references: [id, storeId])
  sale        Sale?             @relation(fields: [saleId, storeId], references: [id, storeId])
  store       Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, productId])
  @@index([storeId, type])
  @@index([storeId, purchaseId])
  @@index([storeId, saleId])
  @@index([productId, storeId], map: "StockMovement_productId_storeId_fkey")
  @@index([purchaseId, storeId], map: "StockMovement_purchaseId_storeId_fkey")
  @@index([saleId, storeId], map: "StockMovement_saleId_storeId_fkey")
  @@index([storeId])
}

model Return {
  id           String
  storeId      String
  type         ReturnType
  referenceId  String
  customerId   String?
  supplierId   String?
  reason       String
  refundAmount Decimal         @db.Decimal(12, 2)
  condition    ReturnCondition
  createdAt    DateTime        @default(now())
  customer     Customer?       @relation(fields: [customerId, storeId], references: [id, storeId])
  store        Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier     Supplier?       @relation(fields: [supplierId, storeId], references: [id, storeId])
  items        ReturnItem[]

  @@id([storeId, id])
  @@unique([id, storeId])
  @@index([storeId, type])
  @@index([storeId, referenceId])
  @@index([customerId, storeId], map: "Return_customerId_storeId_fkey")
  @@index([supplierId, storeId], map: "Return_supplierId_storeId_fkey")
}

model ReturnItem {
  id          String  @id @default(cuid())
  storeId     String
  returnId    String
  productId   String
  productName String
  quantity    Int
  price       Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
  product     Product @relation(fields: [productId, storeId], references: [id, storeId])
  return      Return  @relation(fields: [returnId, storeId], references: [id, storeId], onDelete: Cascade)
  store       Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, returnId])
  @@index([productId, storeId], map: "ReturnItem_productId_storeId_fkey")
  @@index([returnId, storeId], map: "ReturnItem_returnId_storeId_fkey")
}

enum StoreMemberRole {
  OWNER
  ADMIN
  MANAGER
  SALESMAN
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  BKASH
  CARD
  RETURN_ADJUSTMENT
}

enum StockMovementType {
  PURCHASE
  SALE
  STOCK_IN
  STOCK_OUT
  DAMAGE
  RETURN
}

enum ReturnType {
  SALE_RETURN
  PURCHASE_RETURN
}

enum ReturnCondition {
  RESTOCK
  DAMAGE
}
